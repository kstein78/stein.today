# Если на сервере Apache вместо nginx: положите этот файл в корень сайта как .htaccess
ErrorDocument 404 /404.html
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.stein\.today$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^ https://stein.today%{REQUEST_URI} [R=301,L]
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
</IfModule>
