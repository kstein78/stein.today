---
import '@fontsource-variable/piazzolla/opsz.css';
import '@fontsource-variable/piazzolla/opsz-italic.css';
import '@fontsource-variable/onest/index.css';
import '../styles/global.css';
import { ui, LANGS, type Lang } from '../data/content';
import { analytics } from '../data/analytics';
import Consent from '../components/Consent.astro';

interface Props { lang: Lang; title: string; description: string; path: string; /** путь без языка, напр. "cv/" */ noindex?: boolean }
const { lang, title, description, path, noindex = false } = Astro.props;
const t = ui[lang];
const site = Astro.site!.origin;
const url = (l: Lang) => `${site}/${l}/${path}`;
const built = new Date().toISOString().slice(0, 10);
---
<!doctype html>
<html lang={t.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  {analytics.googleVerification && <meta name="google-site-verification" content={analytics.googleVerification} />}
  {analytics.yandexVerification && <meta name="yandex-verification" content={analytics.yandexVerification} />}
  <link rel="canonical" href={url(lang)} />
  {LANGS.map((l) => <link rel="alternate" hreflang={ui[l].htmlLang} href={url(l)} />)}
  <link rel="alternate" hreflang="x-default" href={url('en')} />
  <meta property="og:type" content="profile" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url(lang)} />
  <meta property="og:locale" content={t.ogLocale} />
  <meta property="og:image" content={`${site}/og.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="stein.today" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#eef1ea" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Person', name: 'Konstantin Stein',
    alternateName: ['Константин Штейн', 'Konstantin Štajn', 'Константин Штајн', 'Kosta Stein'],
    url: site, jobTitle: 'CEO, founder, business executive in IT and creative technology',
    knowsAbout: ['IT management', 'Digital media management', 'International expansion', 'Partner search', 'Account management', 'Partnerships', 'Naming', 'Branding', 'Web development', 'Electric vehicles', 'Relocation to Serbia', 'Antique dolls', 'Local history of Vojvodina'],
    knowsLanguage: ['ru', 'de', 'en', 'sr', 'uk'],
    worksFor: { '@type': 'Organization', name: 'Optilife', url: 'https://optilife.rs' },
    address: { '@type': 'PostalAddress', addressLocality: 'Rakovac', addressCountry: 'RS' },
    sameAs: ['https://www.linkedin.com/in/konstantinstein/', 'https://www.facebook.com/konstantin.stein', 'https://x.com/konstantinstein', 'https://github.com/kstein78', 'https://www.instagram.com/kstein78/', 'https://www.google.com/maps/contrib/109485321545547043572/'],
  })} />
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="wrap top">
    <a class="home" href={`/${lang}/`}><img src="/logo.svg" alt="" width="22" height="26" />{t.name}</a>
    <nav aria-label={t.navAria}>
      <a href={`/${lang}/#help`}>{t.nav.help}</a>
      <a href={`/${lang}/#work`}>{t.nav.work}</a>
      <a href={`/${lang}/#projects`}>{t.nav.invest}</a>
      <a href={`/${lang}/#sites`}>{t.nav.sites}</a>
      <a href={`/${lang}/#passions`}>{t.nav.hobby}</a>
      <a href={`/${lang}/#contact`}>{t.nav.contact}</a>
    </nav>
    <div class="langs">
      {LANGS.map((l) => l === lang
        ? <span aria-current="page" lang={l}>{l.toUpperCase()}</span>
        : <a href={`/${l}/${path}`} hreflang={ui[l].htmlLang} lang={ui[l].htmlLang} title={ui[l].langName}>{l.toUpperCase()}</a>)}
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="wrap foot">
    <span>© {new Date().getFullYear()} {t.name} · <a href={`/${lang}/coat-of-arms/`}>{t.coa.footerLink}</a> · <a href={`/${lang}/privacy/`}>{t.privacy.title}</a>{(analytics.ga4 || analytics.yandexMetrika) && <> · <a href="#" data-consent-open>{t.consent.settings}</a></>}</span>
    <span>{t.footer}: {built}</span>
  </footer>
  <Consent lang={lang} />
</body>
</html>
